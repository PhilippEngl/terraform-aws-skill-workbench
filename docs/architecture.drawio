<?xml version="1.0" encoding="UTF-8"?>
<!--
  Icon conventions, verified against draw.io's own AWS4 palette definition
  (jgraph/drawio: src/main/webapp/js/diagramly/sidebar/Sidebar-AWS4.js):

    Service icons  -> coloured rounded-square tile:
                      shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.<service>
    Resource icons -> flat glyph: shape=mxgraph.aws4.<resource>

  Official category fills used below, taken from that file rather than guessed:
    Storage            #7AA116   Compute              #ED7100
    Security/Identity  #DD344C   Networking (VPC)     #8C4FFF
    Machine learning   #01A88D   Management/Gov       #E7157B
    General resources  #1E262E   Front-end web/mobile #DD344C

  Note mxgraph.aws4.endpoint is the API Gateway Endpoint icon. The VPC one is
  mxgraph.aws4.endpoints, plural.
-->
<mxfile host="app.diagrams.net">
  <diagram id="skill-workbench-arch" name="Skill Workbench Architecture">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

